{
  "name": "antdv-style-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:ssr": "node scripts/verify-ssr.mjs",
    "test:tooling": "node scripts/verify-tooling.mjs",
    "test:docs": "playwright test -c playwright.docs.config.ts",
    "test:audit": "node scripts/audit-current.mjs && playwright test -c playwright.audit.config.ts"
  },
  "dependencies": {
    "@antdv-next/cssinjs": "^1.0.6",
    "antdv-next": "^1.5.4",
    "antdv-style": "1.0.0",
    "vue": "3.5.31"
  },
  "devDependencies": {
    "@antdv-next/less2cssinjs": "link:../antdv-style/packages/less2cssinjs",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-antdv-style": "link:../antdv-style/packages/vite-plugin-antdv-style",
    "vue-tsc": "^3.2.5"
  }
}
