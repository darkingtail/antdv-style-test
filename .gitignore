# Publish only the reusable project, never local review/session artifacts.
/*
!/.gitignore
!/README.md
!/package.json
!/pnpm-lock.yaml
!/index.html
!/vite.config.ts
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/playwright.config.ts
!/playwright.docs.config.ts
!/playwright.audit.config.ts
!/src/
!/public/
!/e2e/
!/docs-e2e/
!/audit-e2e/
!/scripts/
!/.vscode/

# Keep historical one-off investigations local.
/scripts/*
!/scripts/verify-ssr.mjs
!/scripts/ssr-fixture.ts
!/scripts/verify-tooling.mjs
!/scripts/audit-current.mjs
!/scripts/audit-runtime-fixture.ts
!/scripts/audit-browser.ts
!/scripts/audit-browser.html

/.vscode/*
!/.vscode/extensions.json

node_modules/
dist/
dist-ssr/
.catpaw/
.env
.env.*
.npmrc
*.pem
*.key
*.p12
*.log
*.local
*.tsbuildinfo
.DS_Store
